{
  "opencollection": "1.0.0",
  "info": {
    "name": "Public Api v3 Applicant Template API",
    "version": "3.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Template",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Templates",
            "type": "http"
          },
