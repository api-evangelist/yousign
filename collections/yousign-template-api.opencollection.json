                "description": "After cursor (pagination)"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "The limit of items count to retrieve."
              }
            ]
          },
          "docs": "Returns the list of all Templates within your Organization."
        }
      ]
    }
  ],
  "bundled": true
